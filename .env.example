# Never prefix secrets with NEXT_PUBLIC_. Never commit .env.local.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional, must be available in your Groq account. Same grounding constraints.
GROQ_FALLBACK_MODEL=
# Required in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXAM_SIGNING_SECRET=
# Optional private deployment gate. All API calls then require Bearer token.
HAVAN_ACCESS_TOKEN=
# Canonical browser origin when behind a reverse proxy, e.g. https://your-app.vercel.app
HAVAN_APP_ORIGIN=
# Demo questions are clearly marked and disabled by default.
ENABLE_DEMO_DATA=false
# Separate optional image generation provider; text-only Groq cannot generate images.
IMAGE_API_KEY=
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
